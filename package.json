{
  "name": "firebase-bank-engine",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "provision-admin": "node scripts/provision-admin.js",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-rip-p661",
    "verify": "npm run check && npm test",
    "emulators:shared": "firebase emulators:start --only firestore --config firebase.shared.json --project demo-x42-shared",
    "start": "node scripts/start-api.js",
    "seed:directory": "node scripts/seed-directory.js",
    "outbox:process": "node scripts/process-outbox.js",
    "reconcile:pending": "node scripts/reconcile-pending.js",
    "seed:platform": "node scripts/seed-platform.js",
    "verify:seed": "node scripts/verify-platform-seed.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^16.4.7",
    "firebase-admin": "^14.5.1"
  },
  "devDependencies": {
    "firebase-tools": "^15.37.0"
  },
  "peerDependencies": {
    "nodemailer": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "argon2": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  }
}
